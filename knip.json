{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["e2e/run.mjs", "e2e/playwright.config.ts", "e2e/**/*.spec.ts"],
      "project": ["e2e/**/*.{ts,mjs}"]
    },
    "packages/shared": {
      "project": "src/**/*.ts"
    },
    "apps/api": {
      "project": "src/**/*.ts",
      "ignoreDependencies": ["@nestjs/schematics"]
    },
    "apps/web": {
      "project": "src/**/*.{ts,tsx}",
      "ignoreExportsUsedInFile": true
    },
    "apps/agent": {
      "project": "src/**/*.ts"
    }
  }
}
