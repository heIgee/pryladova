{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/shared": {
      "project": "src/**/*.ts"
    },
    "apps/api": {
      "project": "src/**/*.ts",
      "ignoreDependencies": ["@nestjs/schematics"]
    },
    "apps/web": {
      "project": "src/**/*.{ts,tsx}",
      "ignoreExportsUsedInFile": true
    },
    "apps/agent": {
      "project": "src/**/*.ts"
    }
  }
}
