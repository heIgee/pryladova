# API container env at ~/pryladova/.env (deploy/bootstrap.sh seeds this). chmod 600. Never commit real values.
GHCR_OWNER=heigee
# Pinned by deploy (git sha). Required — do not use :latest.
IMAGE_TAG=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional integration tiles — restart API after changing
GITHUB_TOKEN=
GITHUB_USERNAME=
STEAM_API_KEY=
STEAM_ID=
INGEST_SECRET=
PORT=3000
SENTRY_DSN=
SESSION_SECRET=
SUPABASE_URL=
# Project URL only — not .../rest/v1
SUPABASE_SECRET_KEY=
# Panel password — Docker Compose mangles $ in bcrypt; use base64 on prod:
#   caddy hash-password | base64 -w0
PANEL_PASSWORD_HASH_B64=
