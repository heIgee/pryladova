# Host edge config for Caddy ({$VAR} placeholders in deploy/Caddyfile).
# Copy to /etc/caddy/pryladova.env on the server. Never commit real values.
# Panel basic_auth hash lives in /etc/caddy/Caddyfile on the server — not here.
#
# systemd drop-in example (/etc/systemd/system/caddy.service.d/pryladova.conf):
#   [Service]
#   EnvironmentFile=/etc/caddy/pryladova.env

PRYLADOVA_DOMAIN=pryladova.duckdns.org
PRYLADOVA_WEB_ROOT=/home/ubuntu/pryladova/web
