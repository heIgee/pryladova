{
  "name": "pryladova",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "prepare": "lefthook install",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "check": "turbo run typecheck lint build",
    "verify": "pnpm exec turbo run typecheck lint build --filter=!agent && pnpm test:coverage && pnpm test:e2e && pnpm knip && pnpm exec turbo run typecheck lint --filter=agent",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm exec turbo run build --filter=@pryladova/shared --filter=api && playwright test -c e2e/playwright.config.ts",
    "dev": "pnpm --filter @pryladova/shared build && concurrently -k \"pnpm --filter api dev\" \"wait-on tcp:127.0.0.1:3000 && pnpm --filter agent dev\" \"wait-on tcp:127.0.0.1:3000 && pnpm --filter web dev\"",
    "dev:api": "pnpm --filter @pryladova/shared build && pnpm --filter api dev",
    "dev:agent": "pnpm --filter @pryladova/shared build && pnpm --filter agent dev",
    "dev:agent:remote": "pnpm --filter @pryladova/shared build && pnpm --filter agent dev:remote",
    "dev:web": "pnpm --filter @pryladova/shared build && pnpm --filter web dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@playwright/test": "^1.62.0",
    "@pryladova/shared": "workspace:*",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "knip": "^6.23.0",
    "lefthook": "^2.1.9",
    "turbo": "^2.10.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10",
    "ws": "^8.21.3"
  }
}
